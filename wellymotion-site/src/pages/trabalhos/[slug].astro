---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import VideoPlayer from '../../components/media/VideoPlayer.astro';
import Tag from '../../components/ui/Tag.astro';
import { ArrowLeft, ArrowUpRight } from 'lucide-astro';
import { getProjects } from '../../lib/sanity';
import WhatsAppButton from '../../components/ui/WhatsAppButton.astro';
import type { Project } from '../../lib/types';
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project: Project) => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project }
const { project } = Astro.props;
---
<Base title={`${project.title} — Wellymotion`} description={project.description || `Conheça o trabalho ${project.title} no portfólio Wellymotion.`} ogImage={project.poster}>
  <article class="container pb-24 pt-36 md:pt-44">
    <a href="/trabalhos" class="mono inline-flex items-center gap-2 text-xs text-ink-400 transition-colors hover:text-lime"><ArrowLeft size={16}/> TODOS OS TRABALHOS</a>
    <div class="mt-8"><SectionLabel number="07"/></div>
    <h1 class="section-title mt-6 max-w-4xl break-words">{project.title}</h1>
    <div class="mt-7 flex flex-wrap items-center gap-3"><Tag text={project.category}/><Tag text={project.format}/></div>
    <div class="organic-panel mt-12 border border-ink-800 bg-ink-900 p-3 sm:p-8">
      <div class={project.format==='9:16'?'mx-auto w-full max-w-[350px]':'mx-auto w-full max-w-[1050px]'}>
        <VideoPlayer title={project.title} poster={project.poster} videoFile={project.videoFile} videoUrl={project.videoUrl} format={project.format}/>
      </div>
    </div>
    <div class="mt-12 grid gap-10 border-t border-ink-800 pt-10 md:grid-cols-[2fr_1fr]">
      <div><h2 class="mono mb-5 text-xs text-gold">SOBRE ESTE PROJETO</h2><p class="max-w-2xl whitespace-pre-line text-lg leading-9 text-ink-400">{project.description||'Projeto de edição e motion graphics.'}</p></div>
      {project.credits?.length ? <div><h2 class="mono mb-5 text-xs text-gold">CRÉDITOS</h2><ul class="space-y-3 text-sm text-ink-400">{project.credits.map(credit=><li>{credit}</li>)}</ul></div> : <div/>}
    </div>
    <div class="mt-20 flex flex-wrap items-center justify-between gap-5 border-t border-ink-800 pt-9"><p class="text-xl font-semibold">Tem um vídeo pra editar?</p><WhatsAppButton formClass="max-[400px]:w-full" class="max-[400px]:w-full">Pedir orçamento <ArrowUpRight size={17}/></WhatsAppButton></div>
  </article>
</Base>
