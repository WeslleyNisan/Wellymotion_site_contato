---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import VideoCard from '../../components/media/VideoCard.astro';
import { ArrowUpRight } from 'lucide-astro';
import { getProjects } from '../../lib/sanity';
import WhatsAppButton from '../../components/ui/WhatsAppButton.astro';
const projects=await getProjects();
const filters=['Todos','Shorts/Reels','Long-form','Motion','Comercial'];
---
<Base title="Trabalhos — Wellymotion" description="Confira edições, Shorts, Reels, vídeos longos e motion do portfólio Wellymotion.">
  <section class="container pb-28 pt-36 md:pt-44">
    <SectionLabel number="06"/><h1 class="section-title mt-7">Todos os<br/><span class="text-lime">trabalhos.</span></h1>
    <p class="lead mt-7">Filtre, escolha e dê o play.</p>
    {projects.length ? <>
      <div class="mt-12 flex flex-wrap gap-2" role="group" aria-label="Filtrar trabalhos por categoria" data-filters>
        {filters.map((filter,index)=><button type="button" data-filter={filter} aria-pressed={index===0?'true':'false'} class={`mono cursor-pointer rounded-full border px-4 py-2.5 text-xs transition-colors ${index===0?'border-lime bg-lime text-ink-950':'border-ink-600 text-ink-100 hover:border-lime'}`}>{filter}</button>)}
      </div>
      <p class="mono mt-5 text-xs text-ink-400" role="status" aria-live="polite" data-filter-status>{projects.length} trabalho(s)</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-grid>
        {projects.map((p,i)=><VideoCard project={p} index={i}/>)}
      </div>
      <p class="mt-10 hidden text-sm text-ink-400" data-empty-filter>Nenhum trabalho nesta categoria ainda.</p>
    </> : <div class="organic-panel mt-14 border border-dashed border-ink-600 bg-ink-900 px-7 py-16"><p class="mono text-xs text-gold">PRJ.00 / EM PREPARAÇÃO</p><h2 class="mt-5 text-3xl font-semibold tracking-tight">O portfólio está sendo organizado.</h2><p class="mt-4 max-w-lg leading-7 text-[#a9ae9e]">Os próximos projetos aparecem aqui.</p><div class="mt-8"><WhatsAppButton>Me chama no WhatsApp <ArrowUpRight size={17}/></WhatsAppButton></div></div>}
  </section>
  <script>
    const root=document.querySelector<HTMLElement>('[data-filters]');
    const grid=document.querySelector<HTMLElement>('[data-grid]');
    const status=document.querySelector<HTMLElement>('[data-filter-status]');
    const empty=document.querySelector<HTMLElement>('[data-empty-filter]');
    root?.querySelectorAll<HTMLButtonElement>('button').forEach(button=>button.addEventListener('click',()=>{
      const key=button.dataset.filter||'Todos';
      root.querySelectorAll<HTMLButtonElement>('button').forEach(b=>{
        const active=b===button;b.setAttribute('aria-pressed',String(active));
        b.classList.toggle('border-lime',active);b.classList.toggle('bg-lime',active);b.classList.toggle('text-ink-950',active);
        b.classList.toggle('border-ink-600',!active);b.classList.toggle('text-ink-100',!active);
      });
      let visible=0;
      grid?.querySelectorAll<HTMLElement>('[data-category]').forEach(card=>{
        const show=key==='Todos'||card.dataset.category===key;
        card.hidden=!show;if(show)visible++;
      });
      if(status)status.textContent=`${visible} trabalho(s)`;
      if(empty)empty.classList.toggle('hidden',visible>0);
    }));
  </script>
</Base>
