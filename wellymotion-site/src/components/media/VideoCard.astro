---
import { ArrowUpRight } from 'lucide-astro';
import Tag from '../ui/Tag.astro';
import VideoPlayer from './VideoPlayer.astro';
import type { Project } from '../../lib/types';
interface Props { project: Project; index?: number; }
const { project, index = 0 } = Astro.props;
---
<article class="work-card overflow-hidden" data-category={project.category}>
  <div class="flex min-h-[250px] items-center justify-center bg-[#E0F2DE] p-5 sm:p-7">
    <div class={project.format==='9:16'?'w-[min(68%,215px)]':'w-full'}>
      <VideoPlayer title={project.title} poster={project.poster} videoFile={project.videoFile} videoUrl={project.videoUrl} format={project.format} />
    </div>
  </div>
  <div class="flex items-start justify-between gap-3 border-t border-ink-800 p-5">
    <div class="min-w-0">
      <p class="mono mb-2 text-[10px] text-ink-400">PRJ.{String(index+1).padStart(2,'0')} / {project.format}</p>
      <a class="work-title inline-block max-w-full text-xl font-semibold tracking-[-.05em] hover:text-lime" href={`/trabalhos/${project.slug}`}><span class="break-words">{project.title}</span></a>
      <div class="mt-3"><Tag text={project.category}/></div>
    </div>
    <a href={`/trabalhos/${project.slug}`} class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink-600 text-lime hover:border-lime" aria-label={`Ver detalhes de ${project.title}`}><ArrowUpRight size={17}/></a>
  </div>
</article>
