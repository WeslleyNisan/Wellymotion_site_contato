---
import { Play, Volume2, Maximize2 } from 'lucide-astro';
interface Props {
  title: string;
  poster: string;
  videoFile?: string;
  videoUrl?: string;
  format?: '16:9'|'9:16';
}
const { title, poster, videoFile, videoUrl, format = '16:9' } = Astro.props;
const source = videoFile || videoUrl || '';
const playable = Boolean(source);
const aspect = format === '9:16' ? 'aspect-[9/16]' : 'aspect-video';
---
<div class={`media-shell group relative mx-auto w-full ${aspect}`} data-video-player data-src={source} data-title={title}>
  <img src={poster} alt={`Capa do vídeo: ${title}`} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
  {playable ? (
    <button type="button" data-start aria-label={`Reproduzir: ${title}`} class="absolute inset-0 z-[2] flex items-center justify-center bg-black/5 transition-colors hover:bg-black/20 focus-visible:outline-offset-[-6px]">
      <span class="flex h-16 w-16 items-center justify-center rounded-full border border-white/30 bg-ink-950/85 text-lime backdrop-blur-sm transition-transform duration-500 ease-out group-hover:scale-110"><Play size={27} fill="currentColor" strokeWidth={1.3} class="ml-1"/></span>
    </button>
  ) : (
    <div class="absolute inset-0 z-[2] flex items-center justify-center"><span class="rounded bg-ink-950/80 px-4 py-2 text-xs text-ink-100">Vídeo indisponível</span></div>
  )}
  <div class="absolute right-3 top-3 z-[3] rounded-sm bg-ink-950/75 px-2 py-1 font-mono text-[10px] tracking-wide text-ink-100">{format}</div>
</div>

<script>
  // JavaScript puro. Elementos <video> ou <iframe> só são criados após clique.
  type VideoKind = 'mp4'|'youtube'|'vimeo'|'unsupported';
  function resolveSource(raw: string): {kind:VideoKind;url:string} {
    try {
      const url = new URL(raw, window.location.href);
      const host = url.hostname.toLowerCase();
      if (host === 'youtu.be') {
        const id = url.pathname.split('/').filter(Boolean)[0];
        if (/^[\w-]{11}$/.test(id)) return {kind:'youtube',url:`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`};
      }
      if (['youtube.com','www.youtube.com','m.youtube.com','youtube-nocookie.com','www.youtube-nocookie.com'].includes(host)) {
        const id = url.searchParams.get('v') || url.pathname.match(/\/(?:shorts|embed|live)\/([\w-]{11})/)?.[1];
        if (id && /^[\w-]{11}$/.test(id)) return {kind:'youtube',url:`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`};
      }
      if (['vimeo.com','www.vimeo.com','player.vimeo.com'].includes(host)) {
        const id = url.pathname.match(/(?:video\/)?(\d+)/)?.[1];
        if (id) return {kind:'vimeo',url:`https://player.vimeo.com/video/${id}?autoplay=1&title=0&byline=0&portrait=0`};
      }
      if (url.protocol === 'https:' || url.protocol === 'http:' || (url.origin === window.location.origin)) {
        if (url.pathname.toLowerCase().endsWith('.mp4') || url.pathname.toLowerCase().endsWith('.webm')) return {kind:'mp4',url:url.href};
      }
    } catch (_) { /* URL inválida */ }
    return {kind:'unsupported',url:''};
  }
  function fmt(n: number): string {
    if (!Number.isFinite(n)) return '0:00';
    return `${Math.floor(n/60)}:${String(Math.floor(n%60)).padStart(2,'0')}`;
  }
  for (const root of document.querySelectorAll<HTMLElement>('[data-video-player]')) {
    const start = root.querySelector<HTMLButtonElement>('[data-start]');
    if (!start) continue;
    let visible = false;
    let requested = false;
    let started = false;
    const source = root.dataset.src || '';
    const media = resolveSource(source);
    const obs = 'IntersectionObserver' in window
      ? new IntersectionObserver(entries => {
        if (entries.some(e => e.isIntersecting)) { visible=true; if (requested) mount(); }
      }, {rootMargin:'180px'}) : null;
    if(obs) obs.observe(root); else visible=true;
    start.addEventListener('click', () => {requested=true; if(visible) mount();});
    function mount() {
      if(started) return;
      started = true;
      obs?.disconnect();
      const posterUrl = root.querySelector('img')?.src || '';
      root.querySelector('img')?.remove();
      start?.remove();
      if (media.kind === 'youtube' || media.kind === 'vimeo') {
        const iframe = document.createElement('iframe');
        iframe.src = media.url;
        iframe.title = root.dataset.title || 'Reprodução do vídeo';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.className = 'absolute inset-0 h-full w-full border-0';
        root.append(iframe);
        return;
      }
      if (media.kind !== 'mp4') {
        const message = document.createElement('p');
        message.className = 'absolute inset-0 grid place-items-center p-4 text-center text-sm text-ink-100';
        message.textContent = 'Não foi possível reproduzir. Confira o link do vídeo.';
        root.append(message);
        return;
      }
      const video = document.createElement('video');
      video.className='absolute inset-0 h-full w-full object-contain bg-[#193B29]';
      video.preload='none';
      video.playsInline=true;
      video.poster=posterUrl;
      const src=document.createElement('source');
      src.src=media.url;
      src.type=media.url.toLowerCase().split('?')[0].endsWith('.webm')?'video/webm':'video/mp4';
      video.append(src); // Só neste ponto injeta <source>.
      root.append(video);
      const controls=document.createElement('div');
      controls.className='media-controls';
      controls.setAttribute('role','group');
      controls.setAttribute('aria-label','Controles do vídeo');
      controls.innerHTML = `<button type="button" data-toggle aria-label="Pausar vídeo">❚❚</button><span data-time class="mono shrink-0 text-[10px] text-ink-100">0:00</span><input data-seek type="range" value="0" min="0" max="100" step=".1" aria-label="Posição do vídeo"/><button type="button" data-mute aria-label="Silenciar vídeo">♫</button><button type="button" data-fullscreen aria-label="Tela cheia">⛶</button>`;
      root.append(controls);
      const btn=controls.querySelector<HTMLButtonElement>('[data-toggle]')!;
      const seek=controls.querySelector<HTMLInputElement>('[data-seek]')!;
      const label=controls.querySelector<HTMLElement>('[data-time]')!;
      const mute=controls.querySelector<HTMLButtonElement>('[data-mute]')!;
      const full=controls.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
      const update=()=>{btn.textContent=video.paused?'▶':'❚❚';btn.setAttribute('aria-label',video.paused?'Reproduzir vídeo':'Pausar vídeo');};
      video.addEventListener('play',update);video.addEventListener('pause',update);
      video.addEventListener('timeupdate',()=>{label.textContent=fmt(video.currentTime);seek.value=String(video.duration?video.currentTime/video.duration*100:0);});
      btn.addEventListener('click',()=>video.paused?void video.play():video.pause());
      seek.addEventListener('input',()=>{if(video.duration)video.currentTime=Number(seek.value)/100*video.duration;});
      mute.addEventListener('click',()=>{video.muted=!video.muted;mute.textContent=video.muted?'×':'♫';mute.setAttribute('aria-label',video.muted?'Ativar som':'Silenciar vídeo');});
      full.addEventListener('click',()=>{if(document.fullscreenElement)void document.exitFullscreen();else void root.requestFullscreen?.();});
      video.play().catch(()=>{ video.controls = true; });
    }
  }
</script>
