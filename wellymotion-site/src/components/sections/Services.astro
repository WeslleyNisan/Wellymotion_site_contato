---
import { ArrowUpRight, RectangleHorizontal, Smartphone } from 'lucide-astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Reveal from '../ui/Reveal.astro';
import Tag from '../ui/Tag.astro';
---
<section id="servicos" class="section border-t border-ink-800"><div class="container">
  <Reveal><SectionLabel number="01"/><div class="mb-12 mt-6 flex flex-wrap items-end justify-between gap-4"><h2 class="section-title">O que eu<br/><span class="text-lime">edito.</span></h2><p class="max-w-[300px] text-sm leading-7 text-[#a9ae9e]">Do conteúdo longo ao vertical.</p></div></Reveal>
  <div class="grid gap-4 md:grid-cols-2">
    <Reveal><article class="organic-card group min-h-[300px] border border-ink-800 bg-ink-900 p-7 transition-colors hover:border-ink-600 sm:p-9"><div class="flex justify-between"><RectangleHorizontal class="text-lime" size={35} strokeWidth={1.4}/><Tag text="16:9 · YOUTUBE" /></div><h3 class="mt-14 text-[31px] font-semibold tracking-[-.05em]">Vídeos longos.</h3><p class="mt-3 max-w-sm leading-7 text-[#a9ae9e]">Narrativa clara, bons cortes e ritmo.</p><span class="mt-6 inline-flex items-center gap-2 text-xs font-semibold text-lime">Edição · Acabamento <ArrowUpRight size={15}/></span></article></Reveal>
    <Reveal><article class="organic-card group min-h-[300px] border border-ink-800 bg-ink-900 p-7 transition-colors hover:border-ink-600 sm:p-9"><div class="flex justify-between"><Smartphone class="text-lime" size={35} strokeWidth={1.4}/><Tag text="9:16 · VERTICAL" /></div><h3 class="mt-14 text-[31px] font-semibold tracking-[-.05em]">Shorts & Reels.</h3><p class="mt-3 max-w-sm leading-7 text-[#a9ae9e]">Edição ágil, legendas e motion.</p><span class="mt-6 inline-flex items-center gap-2 text-xs font-semibold text-lime">Cortes · Motion <ArrowUpRight size={15}/></span></article></Reveal>
  </div>
</div></section>
