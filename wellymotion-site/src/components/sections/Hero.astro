---
import { ArrowUpRight, ArrowDown, Film, Play } from 'lucide-astro';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
---
<section class="relative overflow-hidden pt-36 pb-20 md:pt-44 md:pb-32" id="inicio">
  <div class="container grid items-center gap-14 lg:grid-cols-[1.1fr_.9fr]">
    <div class="relative z-10">
      <Reveal><div class="eyebrow mb-8 flex items-center gap-3 text-xs uppercase text-[#b8beac]"><span class="inline-flex items-center gap-2 text-gold"><span class="h-2 w-2 rounded-full bg-gold"></span> REC</span><span class="text-ink-600">/</span> EDIÇÃO DE VÍDEO · MOTION</div></Reveal>
      <Reveal><h1 class="display">Corte.<br/>Ritmo.<br/><span class="text-lime">Retenção.</span></h1></Reveal>
      <Reveal><p class="mt-8 max-w-[495px] text-[17px] leading-[1.7] text-[#a9ae9e]">Shorts, Reels e vídeos longos. Corte, ritmo e motion com intenção.</p></Reveal>
      <Reveal><div class="hero-actions mt-9 flex flex-wrap gap-3"><WhatsAppButton formClass="max-[400px]:w-full" class="max-[400px]:w-full">Pedir orçamento <ArrowUpRight size={17}/></WhatsAppButton><Button href="#trabalhos" variant="outline">Ver trabalhos <ArrowDown size={17}/></Button></div></Reveal>
      <div class="mono mt-16 flex items-center gap-3 text-[10px] uppercase tracking-wider text-ink-400"><span class="h-px w-10 bg-ink-600"></span> Pará, Brasil / atendimento remoto</div>
    </div>
    <Reveal>
      <div class="hero-visual frame-grid relative min-h-[390px] overflow-hidden border border-ink-800 p-6 sm:min-h-[490px] sm:p-9" aria-label="Arte gráfica inspirada em timeline de edição">
        <div class="flex justify-between gap-3"><span class="mono text-[10px] text-ink-400">PREVIEW / MOTION_01</span><span class="mono text-[10px] text-gold">● REC</span></div>
        <div class="absolute inset-x-9 top-[25%] flex items-center justify-center">
          <div class="relative flex h-48 w-48 items-center justify-center rounded-full border border-[#51975555] sm:h-60 sm:w-60">
            <div class="absolute inset-4 rounded-full border border-dashed border-[#51975580]"></div>
            <div class="absolute -left-5 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full bg-gold"></div>
            <div class="relative flex h-24 w-24 items-center justify-center rounded-full bg-lime text-ink-950 shadow-[0_0_80px_#A8DCAB88]"><Film size={46} strokeWidth={1.5}/></div>
            <svg class="absolute -right-7 -top-9 h-12 w-14 text-gold" viewBox="0 0 70 60" fill="none" aria-hidden="true"><path d="M3 31C22 3 46 9 65 3M65 3l-7 19M65 3L45 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
        <div class="absolute inset-x-6 bottom-7 sm:inset-x-9">
          <div class="mono mb-3 flex items-center justify-between text-[10px] text-ink-400"><span>TIMELINE / EDIT_001</span><span>00:00:13:24</span></div>
          <div class="visual-timeline flex flex-col gap-1.5"><span style="width:88%"></span><span style="width:65%;margin-left:17%"></span><span style="width:45%;margin-left:35%"></span></div>
          <div class="mt-4 flex items-center justify-between border-t border-ink-600 pt-3"><span class="mono text-[10px] text-ink-400">24 FPS · 1920 × 1080</span><span class="text-xs font-medium text-lime">WELLYMOTION / 2026</span></div>
        </div>
      </div>
    </Reveal>
  </div>
  <div class="container mt-16 flex items-center gap-3 text-[10px] uppercase tracking-[.2em] text-ink-400"><span>01 / 06</span><div class="h-px max-w-28 flex-1 bg-ink-600"></div><span>Role para explorar</span></div>
</section>
