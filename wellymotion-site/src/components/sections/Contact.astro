---
import { ArrowUpRight, Instagram, MessageCircle, Mail } from 'lucide-astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Reveal from '../ui/Reveal.astro';
import { SITE } from '../../lib/site';
---
<section id="contato" class="section border-t border-ink-800"><div class="container">
  <Reveal><SectionLabel number="05"/><div class="mt-7 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end"><div><h2 class="section-title">Tem vídeo<br/>pra <span class="text-lime">editar?</span></h2><p class="lead mt-6">Tem uma ideia? Me chama e manda a referência.</p></div><span class="mono text-xs text-gold">[ LET'S TALK ]</span></div></Reveal>
  <div class="mt-12 grid gap-4 md:grid-cols-3">
    <Reveal><form action="/api/contato" method="POST" target="_blank" class="h-full"><button type="submit" class="organic-card group block h-full min-h-44 w-full cursor-pointer border border-ink-800 bg-ink-900 p-6 text-left transition-colors hover:border-lime"><div class="flex items-start justify-between"><MessageCircle size={26} class="text-lime"/><ArrowUpRight size={19} class="transition-transform group-hover:-translate-y-1 group-hover:translate-x-1"/></div><h3 class="mt-9 text-2xl font-semibold tracking-[-.04em]">WhatsApp</h3><p class="mono mt-2 text-xs text-ink-400">Clique para conversar</p></button></form></Reveal>
    <Reveal><a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="organic-card group block h-full min-h-44 border border-ink-800 bg-ink-900 p-6 transition-colors hover:border-lime"><div class="flex items-start justify-between"><Instagram size={26} class="text-lime"/><ArrowUpRight size={19} class="transition-transform group-hover:-translate-y-1 group-hover:translate-x-1"/></div><h3 class="mt-9 text-2xl font-semibold tracking-[-.04em]">Instagram</h3><p class="mono mt-2 text-xs text-ink-400">{SITE.instagramHandle}</p></a></Reveal>
    <Reveal>{SITE.email ? <a href={`mailto:${SITE.email}`} class="organic-card group block h-full min-h-44 border border-ink-800 bg-ink-900 p-6 transition-colors hover:border-lime"><div class="flex items-start justify-between"><Mail size={26} class="text-lime"/><ArrowUpRight size={19}/></div><h3 class="mt-9 text-2xl font-semibold tracking-[-.04em]">E-mail</h3><p class="mono mt-2 break-all text-xs text-ink-400">{SITE.email}</p></a> : <div class="organic-card h-full min-h-44 border border-ink-800 bg-ink-900 p-6"><Mail size={26} class="text-ink-400"/><h3 class="mt-9 text-2xl font-semibold tracking-[-.04em]">E-mail</h3><p class="mono mt-2 text-xs text-ink-400">Canal em configuração</p></div>}</Reveal>
  </div>
</div></section>
